# BuildInfo.h is regenerated by the pre-commit hook, so every commit touches it
# and any merge or rebase between branches would otherwise conflict on it. Its
# contents are derived, never authored, so resolving in favour of whichever side
# we are keeping is always right - the next commit restamps it anyway.
#
# Requires the driver to be defined once per clone:
#     git config merge.ours.driver true
# Without it git falls back to a normal merge and the conflicts return.
code/src/PhoenixSketch/BuildInfo.h merge=ours
